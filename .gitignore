# What may enter the repository. Line endings are governed separately by
# .gitattributes (LF everywhere) — this file only decides inclusion.
#
# Lock files are deliberately NOT ignored: pnpm-lock.yaml and uv.lock must be
# committed for reproducible installs (BIG-PROMPT s2.4).

# --- Node / frontend -------------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / backend ------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.venv/
.venv_old/
venv/
.uv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# --- Test artefacts --------------------------------------------------------
playwright-report/
blob-report/
test-results/
backend/htmlcov/

# Per-run browser-test state (F057): the super-admin password the preparation
# generated, and the accounts the workflow created. Regenerated on every run,
# never shared, never committed.
frontend/tests/e2e/.state/

# --- Secrets and local configuration ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Local record of development accounts. NEXT_PROMPT.md lists WHICH accounts
# exist and points here; the passwords themselves must never be committed.
LOCAL_CREDENTIALS.md

# --- Runtime data (never commit uploaded or generated files) ---------------
/uploads/
/data/
*.sqlite3

# --- Editors and OS --------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Reference material (safety net only) ----------------------------------
# The QTC360 archive and the source tree stay OUTSIDE the repo by design (see
# docs/REPOSITORY_AUDIT.md s7): they are untrusted reference inputs and must
# never be committed, even if a copy is dropped back into the workspace.
qtc360*.zip
BIG-PROMPT.txt

# ...except the one canonical copy of the requirements text, which lives in
# the pack on purpose (operator instruction 2026-10-10): sessions consult it
# in-repo instead of reading D:\RESORS_REFERENCE\. It is kept byte-identical
# to the archive original (SHA-256 7c97b4eb…, .gitattributes marks it -text),
# must never be edited in place, and any OTHER BIG-PROMPT.txt in the
# workspace is still caught by the rule above.
!claude_code_pack/BIG-PROMPT.txt
