# Copy to .env and replace every placeholder before use:  cp .env.example .env
#
# The real .env is git-ignored and must never be committed. These values are
# placeholders for LOCAL DEVELOPMENT ONLY — they are not production secrets, and
# the application must refuse to start in production with placeholder values
# (BIG-PROMPT §11.5; that startup check arrives with F028/F060).

# --- PostgreSQL (development) ----------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=app_dev
# Host port published by docker-compose.yml. Change if something else already
# uses 5432 on your machine.
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
# Consumed by the application from F023 onward (SQLAlchemy async engine).
DATABASE_URL=postgresql+asyncpg://app:replace-with-a-generated-password@localhost:5432/app_dev
ENVIRONMENT=development

# --- Session lifetimes (used from F028; defaults match ARCHITECTURE §3) -----
# Idle timeout is refreshed on activity; the absolute lifetime never moves.
# SESSION_IDLE_TIMEOUT_MINUTES=720
# SESSION_ABSOLUTE_LIFETIME_DAYS=30

# --- CSRF origin allow-list (used from F029) --------------------------------
# Comma-separated browser origins allowed to make unsafe requests. In
# development the browser talks to the Vite dev server (which proxies /api),
# so the default — http://localhost:5173 — is the frontend's origin. A
# production deployment is same-origin behind Caddy and must set its public
# origin here; F060 validates that it is set explicitly.
# ALLOWED_ORIGINS=http://localhost:5173

# --- Password policy and login throttling (F026; consumed from F028) --------
# The Argon2 cost parameters are NOT configurable here on purpose — a
# deployment must not be able to quietly weaken the hash function (they are
# reviewed constants in app/core/security.py).
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MAX_LENGTH=128
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- One-time super-admin bootstrap (used from F027) ------------------------
# Read by the bootstrap CLI alone (`uv run python -m app.bootstrap_admin`),
# never by the app at runtime — and deliberately absent from source, so there
# is no default account. Omit the password to be prompted, or pass
# --generate-password to have one generated and shown exactly once.
# After bootstrapping: remove the password from this file, and record the
# credentials in the git-ignored LOCAL_CREDENTIALS.md.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-generated-password
