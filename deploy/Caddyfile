# The public edge (F059). One site, one origin: the SPA and the API share it, so
# the browser's relative /api/v1 needs no CORS (ARCHITECTURE §1). SITE_ADDRESS
# comes from the environment (docker-compose.prod.yml requires it); Caddy obtains
# and renews the certificate itself for a public name.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Browser-facing headers (F060; BP-6.4). One policy for the SPA and the API,
	# since both are this origin. The CSP allows what the built SPA needs and
	# nothing it does not: no inline script (the theme script is a file), no
	# third-party origin, no plugin, no framing. style-src allows inline style
	# because the component library positions popovers with style attributes.
	# blob: is for the object URLs the file preview and the PDF viewer create.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Readiness is not public (BP-8.3: `GET /api/v1/ready` is "[protected
	# appropriately at ingress]", and this rule *is* the protection). It answers
	# which dependencies of this deployment are up — PostgreSQL, the converter,
	# the report engine (F065) — so it belongs to the box and not to the
	# internet. The API asks for no session on that route for the same reason:
	# its callers are the container, a monitor and the operator, and none of
	# them can hold a session cookie. A 404, not a 403: an external caller
	# learns nothing about which internal paths exist. The body keeps the API's
	# `{ "detail": ... }` error shape, so a client that parses it is not
	# surprised by a refusal that did not come from the API.
	handle /api/v1/ready* {
		header Content-Type "application/json"
		respond `{"detail":"Not Found"}` 404
	}

	# The only route to the API: the backend publishes no port of its own.
	handle /api/* {
		# Caddy's own default body cap would reject a legitimate upload before the
		# API sees it. This sits above the API's per-file cap
		# (STORAGE_MAX_UPLOAD_BYTES, 10 MiB) so the API's refusal is the one a user
		# reads, and multipart overhead has room.
		request_body {
			max_size 16MB
		}
		# The address the API logs and throttles on. Caddy sets it to the peer it
		# actually sees, discarding anything the client sent. The API trusts this
		# header only from this proxy's fixed address (FORWARDED_ALLOW_IPS in
		# docker-compose.prod.yml).
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Built assets are content-hashed. A missing one is a 404, not index.html: a
	# tab left open across a deploy would otherwise run HTML as a script.
	handle /assets/* {
		root * /srv
		file_server
	}

	# Everything else is the SPA. A file that exists is served as is; any other
	# path (a deep link, a browser refresh) gets index.html and the router takes
	# over (BP-4.11).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
