# Build output and reports — never read, never format.
dist/
coverage/

# Playwright's own output (F057): the HTML report and the run's last-run marker
# are written by the runner after a run, not authored. `.gitignore` already keeps
# them out of the repository; this keeps them out of `format:check` too, which
# reads the working tree rather than the index and would otherwise fail on a
# developer's machine that has just run the browser suite.
playwright-report/
test-results/

# Generated by `pnpm run api:types` (F018). The generator owns these bytes and
# CI (F061) regenerates them and fails on any diff, so they stay out of both
# `format` and `format:check`. Never hand-edit them.
src/lib/generated/

# pnpm owns this file's format; `pnpm install` rewrites it.
pnpm-lock.yaml
