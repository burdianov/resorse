# Copy to .env.production ON THE SERVER and replace every value. The real file is
# git-ignored and must never be committed. Used by docker-compose.prod.yml via
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build --wait
#
# Nothing in docker-compose.prod.yml has a default: a missing value stops Compose
# before any container starts (BIG-PROMPT §11.5).

# The public name Caddy serves and obtains a certificate for, e.g. resors.example.com.
# Must resolve to this server and ports 80 and 443 must be reachable.
SITE_ADDRESS=replace-with-your-domain

# Put only URL-safe characters in the password (hex is simplest): it is embedded
# in DATABASE_URL. Generate with: openssl rand -hex 32
POSTGRES_USER=resors
POSTGRES_PASSWORD=replace-with-a-generated-hex-string
POSTGRES_DB=resors

# The one-time super-admin bootstrap is NOT configured here. Run it after the
# first `up`, passing the credentials on that command only:
#   docker compose -f docker-compose.prod.yml --env-file .env.production run --rm -e BOOTSTRAP_ADMIN_EMAIL=... backend python -m app.bootstrap_admin --generate-password
